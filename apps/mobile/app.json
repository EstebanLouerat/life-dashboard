{
  "expo": {
    "name": "Life Dashboard",
    "slug": "life-dashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.esteban.lifedashboard",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.esteban.lifedashboard",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#33424D"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "../../node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ],
          "widgets": [
            {
              "name": "Water",
              "label": "Eau",
              "description": "Ajoute un verre d'un geste (1×1, 2×1 ou plus grand)",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Treatments",
              "label": "Traitements",
              "description": "Coche les prises du jour",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Sleep",
              "label": "Sommeil",
              "description": "Note ta nuit en un geste",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Groceries",
              "label": "Courses",
              "description": "La liste à cocher en magasin, et le dîner du soir",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Workout",
              "label": "Séance",
              "description": "Lance la séance du jour et pilote-la : précédent, pause, suivant, arrêt",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "lifedashboard",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f2de6ca9-88df-4b61-8c01-c7f890c0af7b"
      }
    },
    "owner": "sbeuteu-projet-perso"
  }
}
